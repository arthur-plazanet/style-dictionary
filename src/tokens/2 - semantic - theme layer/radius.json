{
  "theme": {
    "radius": {
      "scale": {
        "value": "var(--radius-md, var(--border-radius-scale))"
      },
      "value": {
        "none": "{border.radius.0}",
        "sm": "{border.radius.1}",
        "md": "{border.radius.2}",
        "lg": "{border.radius.4}",
        "full": "{border.radius.9999}"
      }
    }
  },
  "attributes": { "tokenTier": "theme" },
  "radius": {
    "light": {
      "value": "calc(var(--border-radius-base) / var(--border-radius-scale))"
    },
    "medium": {
      "value": "calc(var(--border-radius-base) * var(--border-radius-scale))"
    },
    "heavy": {
      "value": "calc(var(--border-radius-base) * 2 * var(--border-radius-scale))"
    }
  }
}
