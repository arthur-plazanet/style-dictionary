{
  "shadow": {
    "xs": {
      "value": "calc(var(--theme-shadow-base) / 3 * var(--theme-shadow-scale))"
    },
    "sm": {
      "value": "calc(var(--theme-shadow-base) / 2 * var(--theme-shadow-scale))"
    },
    "md": {
      "value": "calc(var(--theme-shadow-base) * var(--theme-shadow-scale))"
    },
    "lg": {
      "value": "calc(var(--theme-shadow-base) * 2 * var(--theme-shadow-scale))"
    },
    "xl": {
      "value": "calc(var(--theme-shadow-base) * 4 * var(--theme-shadow-scale))"
    },
    "attributes": { "tokenTier": "semantic" }
  }
}
